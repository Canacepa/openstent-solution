<section id="team">
    <p class="kicker">L'équipe</p>
    <h2>Chirurgien, ingénieurs, couturières de valves.</h2>
    <div class="team">
        <figure>
            <img src="{{ asset('images/equipe-portrait.webp') }}" alt="Deux mains tenant un modèle anatomique de cœur."
                 width="1400" height="932" loading="lazy" decoding="async">
        </figure>
        <div>
            <p>Un chirurgien cardiaque inventeur, des ingénieurs du dispositif médical et des
                artisans venus du textile et de la maroquinerie, réunis à Amiens autour d'une seule valve.</p>
            <a class="act act--ghost" href="{{ path('app_team') }}">Voir toute l'équipe</a>
        </div>
    </div>
</section>
<section id="partenaires">
    <h2>Nos partenaires</h2>
    <ul class="partners">
        {% for p in [['initiative-somme', 'Initiative Somme', 505], ['french-tech-seed', 'French Tech Seed', 160], ['eurasante', 'Eurasanté', 160], ['cci', 'CCI', 412], ['amiens-cluster', 'Amiens Cluster', 480]] %}
            <li><img src="{{ asset('images/partners/' ~ p[0] ~ '.webp') }}" alt="{{ p[1] }}" width="{{ p[2] }}" height="160" loading="lazy" decoding="async"></li>
        {% endfor %}
    </ul>
</section>
