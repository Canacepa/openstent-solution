{# hero-shader.js reads its settings from these sliders; the panel itself is hidden by CSS #}
<details class="hud">
    <summary>Canvas</summary>
    <span class="rd"><b id="fps">&mdash;</b> fps</span>
    {% for c in [
        ['sp', 'Speed', 0, 2.5, 0.05, '0.30'],
        ['bpm', 'BPM', 6, 160, 1, '18'],
        ['spread', 'Spread', 0.5, 4, 0.1, '2.0'],
        ['swell', 'Swell', 0, 3, 0.05, '1.20'],
        ['wd', 'Warp', 0, 1.6, 0.02, '0.46'],
        ['cell', 'Cell', 1, 14, 1, '1'],
        ['gain', 'Gain', 0.4, 2.5, 0.1, '0.80'],
        ['off', 'Drop', -200, 520, 10, '10'],
        ['clr', 'Clear', 0, 0.7, 0.02, '0.00']
    ] %}
        <label>{{ c[1] }} <input type="range" id="{{ c[0] }}" min="{{ c[2] }}" max="{{ c[3] }}" step="{{ c[4] }}" value="{{ c[5] }}">
            <output class="rd" for="{{ c[0] }}" id="{{ c[0] }}_v">{{ c[5] }}</output></label>
    {% endfor %}
    <button type="button" id="pause">Pause</button>
    <button type="button" id="copy">Copy values</button>
    <code class="summary" id="summary"></code>
</details>
