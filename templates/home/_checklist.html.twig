{# `steps` comes from the database (edited in /admin/checklist), `members` is the team. #}
{% set done = steps|filter(s => s.status == 'done')|length %}
{% set total = steps|length %}
<section id="checklist">
    <div class="checklist-main">
        <p class="kicker">Où en est le projet</p>
        {% if total %}
            <p class="lede">{{ done }} étape{{ done > 1 ? 's' : '' }} sur {{ total }} terminée{{ done > 1 ? 's' : '' }}.</p>
            <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="{{ total }}" aria-valuenow="{{ done }}">
                <span style="--w: {{ (done / total * 100)|round }}%"></span>
            </div>
            <ol class="checklist">
                {% for s in steps %}
                    <li class="{{ s.status }}" style="--i: {{ loop.index0 }}">
                        <span class="mark" aria-hidden="true"></span>
                        <div><b>{{ s.title }}</b><p>{{ s.text }}</p></div>
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
    </div>

    <aside class="encart" aria-label="L'équipe">
        <p class="kicker">L'équipe</p>
        <h3>{{ members|length }} personnes, une seule valve.</h3>
        <img class="encart-photo" src="{{ asset('images/team.webp') }}" alt="L'équipe d'Open Stent Solution réunie."
             width="3840" height="2554" loading="lazy" decoding="async">
        <p>Un chirurgien cardiaque inventeur, des ingénieurs du dispositif médical et des artisans
            venus du textile et de la maroquinerie, réunis à Amiens.</p>
        <a class="act act--ghost" href="{{ path('app_team') }}">Voir l'équipe</a>
    </aside>
</section>
