{% extends 'base.html.twig' %}

{% block title %}Équipe{% endblock %}

{% block body %}
    <div class="sheet page-top">
        <section>
            <h1 class="h2">Notre <strong>équipe</strong></h1>
            <div class="team team--hero">
                <figure>
                    <img src="{{ asset('images/equipe-portrait.webp') }}" alt="Deux mains tenant un modèle anatomique de cœur."
                         width="1400" height="932" decoding="async">
                </figure>
                <div>
                    <p>Un chirurgien cardiaque inventeur, des ingénieurs du dispositif médical et des
                        artisans venus du textile et de la maroquinerie, réunis à Amiens autour d'une seule valve.</p>
                </div>
            </div>
            <div class="crew">
                {% for m in members %}
                    <article class="member" data-controller="modal">
                        {% if m.photo %}<img src="{{ asset('uploads/team/' ~ m.photo) }}" alt="{{ m.name }}" width="700" loading="lazy" decoding="async">{% else %}<span class="member-nophoto" aria-hidden="true"></span>{% endif %}
                        <div class="member-text">
                            <h2>{{ m.name }}</h2>
                            <p class="role">{{ m.role }}</p>
                            <button type="button" class="more" data-action="modal#open">En savoir plus <span aria-hidden="true">&rsaquo;</span></button>
                        </div>
                        <dialog class="modal" data-modal-target="dialog" data-action="click->modal#backdrop" aria-label="{{ m.name }}">
                            <button type="button" class="modal-close" data-action="modal#close" aria-label="Fermer">&times;</button>
                            {% if m.photo %}<img src="{{ asset('uploads/team/' ~ m.photo) }}" alt="" width="700" loading="lazy" decoding="async">{% endif %}
                            <div class="modal-body">
                                <h3>{{ m.name }}</h3>
                                <p class="role">{{ m.role }}</p>
                                {% for paragraph in m.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
                            </div>
                        </dialog>
                    </article>
                {% endfor %}
            </div>
            <p class="lorem-note">Nous remercions Virginie Sueur pour la qualité de ses photos.</p>
        </section>
    </div>
{% endblock %}
