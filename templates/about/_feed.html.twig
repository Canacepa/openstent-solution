{% if news is not empty %}
<section id="feed">
    <p class="kicker">Actualités</p>
    <h2>Le projet avance.</h2>
    <ul class="feed">
        {% for n in news %}
            <li>
                <time datetime="{{ n.publishedAt|date('Y-m-d') }}">{{ n.dateLabel }}</time>
                <div><b>{{ n.title }}</b>
                    <p>{{ n.summary }}</p></div>
            </li>
        {% endfor %}
    </ul>
    <p class="more-row"><a class="more" href="{{ path('app_archives') }}">Toutes les actualités <span aria-hidden="true">&rsaquo;</span></a></p>
</section>
{% endif %}
