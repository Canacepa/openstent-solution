{% extends 'base.html.twig' %}

{% block body %}
    <div class="sheet page-top">
        <section>
            <nav class="admin-nav" aria-label="Administration">
                <a href="{{ path('admin_news_index') }}">Actualités</a>
                <a href="{{ path('admin_team_index') }}">Équipe</a>
                <a href="{{ path('app_logout') }}" class="admin-logout">Se déconnecter</a>
