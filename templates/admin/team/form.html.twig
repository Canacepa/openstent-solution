{% extends 'admin/layout.html.twig' %}

{% block title %}{{ title }} — administration{% endblock %}

{% block admin %}
    <h1 class="h2">{{ title }}</h1>
    {% if member.photo %}
        <p><img class="admin-thumb" src="{{ asset('uploads/team/' ~ member.photo) }}" alt="Photo actuelle" width="120"></p>
    {% endif %}
    {{ form_start(form, {attr: {class: 'form'}}) }}
        {{ form_widget(form) }}
        <button type="submit">Enregistrer</button>
    {{ form_end(form) }}
    <p><a href="{{ path('admin_team_index') }}">Annuler</a></p>
{% endblock %}
