# Settings for the pre-production stack (compose.preprod.yaml).
# Copy this file to .env.preprod (ignored by git) and fill it in. Never commit the real one.
#
# Secrets can be generated with:  openssl rand -hex 32

APP_SECRET=

MYSQL_DATABASE=openstent
MYSQL_USER=app
# letters and digits only: these values are put in a URL (otherwise URL-encode them)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_VERSION=8.4

# Host name served by Caddy. A real domain gets a Let's Encrypt certificate (the DNS must point to
# the server and ports 80 and 443 must be reachable). ":80" serves plain HTTP, for an internal test.
SERVER_NAME=:80
DEFAULT_URI=http://localhost
HTTP_PORT=80
HTTPS_PORT=443

# e.g. smtp://user:pass@smtp.example.com:587  (null://null sends nothing)
MAILER_DSN=null://null
